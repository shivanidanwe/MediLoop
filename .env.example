# Environment Variable Configuration Template for MediLoop
ENVIRONMENT=production
PROJECT_NAME="MediLoop Healthcare Platform"

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=mediloop
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@db:5432/mediloop

# Security & JWT Tokens
SECRET_KEY=change_this_to_a_random_64_character_secret_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider API Keys
GEMINI_API_KEY=your_google_gemini_api_key_here

# React Dashboard API Connection
VITE_API_BASE_URL=http://localhost/api/v1
